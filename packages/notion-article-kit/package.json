{
  "name": "notion-article-kit",
  "version": "0.0.1",
  "description": "Notion Article Kit is a collection of reusable components and utilities for zegiha's personal branding website",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    "./server": "./dist/server.js",
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./tokens": {
      "types": "./tokens/index.ts",
      "default": "./tokens/index.ts"
    }
  },
  "scripts": {
    "build:server": "npx tsc server.ts --outDir dist --declaration --esModuleInterop --module CommonJS --target ES2022 --moduleResolution Node --skipLibCheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@notionhq/client": "^5.4.0",
    "katex": "^0.16.27",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vanilla-extract/css": "^1.16.2",
    "@vanilla-extract/recipes": "^0.5.7"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": ">=19.1.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
